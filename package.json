{
  "name": "ai-story-teachers",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "admin:create": "npm run admin:create --workspace server",
    "admin:create:local": "node server/src/create-admin.js --generate",
    "setup:local": "node scripts/setup-local.js",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
